@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject ISnackbar Snackbar
@using HQ.Desktop.Auth
@implements IDisposable

<aside class="side-nav @(_open ? "is-open" : "is-collapsed")" dir="rtl">
    <div class="side-top">
        <button class="toggle-bar" title="@(_open ? "طي القائمة" : "فتح القائمة")" @onclick="Toggle">
            <MudIcon Icon="@(_open ? Icons.Material.Rounded.MenuOpen : Icons.Material.Rounded.Menu)" />
        </button>
        <div class="brand" @onclick='() => Navigation.NavigateTo("/")'>
            <div class="logo-mark">HQ</div>
            <div class="brand-copy">
                <div class="brand-name">المقر الرئيسي</div>
                <div class="brand-tag">Headquarters</div>
            </div>
        </div>
    </div>

    <nav class="side-links">
        <button class="nav-link @(IsActive("/") ? "active" : "")" title="لوحة المقارنات المركزية" @onclick='() => NavigateTo("/")'>
            <MudIcon Icon="@Icons.Material.Rounded.Dashboard" />
            <span>لوحة المقارنات والمتابعة</span>
        </button>

        <button class="nav-link @(IsActive("/branches-settings") ? "active" : "")" title="إعدادات الفروع وسحب الداتا" @onclick='() => NavigateTo("/branches-settings")'>
            <MudIcon Icon="@Icons.Material.Rounded.Storefront" />
            <span>إعدادات الفروع</span>
        </button>

        <button class="nav-link @(IsActive("/warehouses-settings") ? "active" : "")" title="إعدادات المخازن الرئيسية" @onclick='() => NavigateTo("/warehouses-settings")'>
            <MudIcon Icon="@Icons.Material.Rounded.Warehouse" />
            <span>المخازن الرئيسية</span>
        </button>

        <button class="nav-link @(IsActive("/settings") ? "active" : "")" title="إعدادات المقر العامة" @onclick='() => NavigateTo("/settings")'>
            <MudIcon Icon="@Icons.Material.Rounded.Settings" />
            <span>إعدادات المقر</span>
        </button>
    </nav>

    <div class="side-foot">
        <div class="user-pill" title="@_userName">
            <div class="user-avatar">@_initials</div>
            <span class="user-name">@_userName</span>
        </div>
        <button class="foot-btn" title="تسجيل الخروج" @onclick="Logout">
            <MudIcon Icon="@Icons.Material.Rounded.Logout" Size="Size.Small" />
            <span>خروج</span>
        </button>
        <button class="foot-btn danger" title="إغلاق التطبيق" @onclick="ExitApp">
            <MudIcon Icon="@Icons.Material.Rounded.Close" Size="Size.Small" />
            <span>إغلاق</span>
        </button>
    </div>
</aside>

@code {
    private bool _open = true;
    private string _userName = "مدير المقر";
    private string _initials = "HQ";

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        _userName = state.User.Identity?.Name ?? "مدير المقر";
        _initials = _userName.Length >= 2 ? _userName[..2] : "HQ";
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private void NavigateTo(string path)
    {
        Navigation.NavigateTo(path);
        StateHasChanged();
    }

    private bool IsActive(string path)
    {
        var relative = Navigation.ToBaseRelativePath(Navigation.Uri);
        var cleanRel = string.IsNullOrEmpty(relative) ? "/" : ("/" + relative.Split('?')[0].TrimEnd('/'));
        var cleanPath = path.TrimEnd('/');
        if (string.IsNullOrEmpty(cleanPath)) cleanPath = "/";
        return cleanRel.Equals(cleanPath, StringComparison.OrdinalIgnoreCase);
    }

    private void Toggle() => _open = !_open;

    private void Logout()
    {
        if (AuthStateProvider is HqAuthStateProvider auth)
            auth.SignOut();
        Snackbar.Add("تم تسجيل الخروج", Severity.Info);
        Navigation.NavigateTo("/login");
    }

    private static void ExitApp() => System.Windows.Application.Current.Shutdown();

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
