@page "/login"
@layout AuthLayout
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject ISnackbar Snackbar
@inject IHttpClientFactory ClientFactory
@inject IConfiguration Configuration
@using System.Text.Json
@using System.Net.Http.Json
@using HQ.Desktop.Auth
@using POS.Contract.Dtos.AccountDtos

<div class="login-page">
    <!-- Left Brand Section - Enhanced Luxury Gold Gradient -->
    <div class="brand-section">
        <button class="close-app-btn" @onclick="ExitApp" title="إغلاق التطبيق">
            <i class="bi bi-x-lg"></i>
        </button>

        <div class="brand-content">
            <!-- Official New Tech Logo with "N" letter -->
            <div class="brand-logo-container">
                <div class="brand-logo-shimmer"></div>
                <div class="brand-logo-frame">
                    <img src="images/Logo.png" class="brand-logo" alt="New Tech HQ Logo" />
                </div>
            </div>

            <h1 class="brand-title">New Tech HQ</h1>
            <p class="brand-subtitle">HEADQUARTERS MANAGEMENT SYSTEM</p>
            <div class="gold-accent-line"></div>
            <p class="brand-tagline">النظام المركزي لإدارة ومقارنة الفروع</p>
        </div>
    </div>

    <!-- Right Login Section -->
    <div class="login-section">
        <div class="login-card">
            <div class="login-header">
                <!-- App Window Icon Badge -->
                <div class="app-icon-badge" title="New Tech HQ">
                    <img src="images/Logo.png" alt="HQ App Icon" class="hq-ico-img" />
                </div>
                <h2>مرحبًا بك</h2>
                <p class="login-hint">اختر المستخدم وأدخل الرقم السري للمتابعة</p>
            </div>

            <div class="login-form">
                <!-- User Select Dropdown -->
                <div class="form-group">
                    <div class="select-container">
                        <select dir="rtl" class="form-control-custom select-user" @onchange="OnUserChanged" disabled="@_isLoadingUsers">
                            @if (_isLoadingUsers)
                            {
                                <option disabled selected>جاري تحميل المستخدمين من الخادم...</option>
                            }
                            else
                            {
                                <option value="" disabled selected="@(string.IsNullOrEmpty(_selectedUserName))">اختر المستخدم</option>
                                @foreach (var user in _users)
                                {
                                    var display = !string.IsNullOrWhiteSpace(user.DisplayName) ? user.DisplayName : user.UserName;
                                    <option value="@user.UserName">@display</option>
                                }
                            }
                        </select>
                    </div>
                </div>

                <!-- PIN / Password Display -->
                <div class="form-group">
                    <input type="password" class="form-control-custom otp-display" placeholder="● ● ● ●"
                           @bind="_pin" @bind:event="oninput" @onkeydown="OnKeyDown" />
                </div>

                <!-- Keypad 85px Circle Grid -->
                <div class="keypad-container">
                    <div class="keypad-grid">
                        @for (var i = 1; i <= 9; i++)
                        {
                            var digit = i.ToString();
                            <div class="keypad-btn" @onclick="() => AddDigit(digit)">@digit</div>
                        }
                        <div class="keypad-btn action-btn bs" @onclick="DeleteLast">
                            <i class="bi bi-backspace"></i>
                        </div>
                        <div class="keypad-btn" @onclick='() => AddDigit("0")'>0</div>
                        <div class="keypad-btn action-btn del" @onclick="Clear">C</div>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="action-buttons">
                    <button class="btn-custom btn-primary-custom" @onclick="SubmitLogin" disabled="@_isLoggingIn">
                        @if (_isLoggingIn)
                        {
                            <span>جاري التحقق...</span>
                        }
                        else
                        {
                            <span>دخول</span>
                        }
                    </button>
                    <button class="btn-custom btn-danger-custom" @onclick="ExitApp">خروج</button>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<UserDto> _users = new();
    private string _selectedUserName = "";
    private string _pin = "";
    private bool _isLoadingUsers = true;
    private bool _isLoggingIn = false;
    private HttpClient? _client;

    protected override async Task OnInitializedAsync()
    {
        await LoadUsersAsync();
    }

    private async Task<HttpClient> GetClientAsync()
    {
        if (_client != null) return _client;

        var baseUrl = Configuration["ApiSettings:BaseUrl"] ?? "http://100.79.100.86:5050";
        var fallbackUrl = Configuration["ApiSettings:FallbackUrl"] ?? "http://localhost:5050";

        // Test baseUrl first with a fast 2-second timeout
        try
        {
            var testClient = new HttpClient { BaseAddress = new Uri(baseUrl), Timeout = TimeSpan.FromSeconds(2) };
            var ping = await testClient.GetAsync("/api/Account/GetUsers");
            if (ping.IsSuccessStatusCode)
            {
                _client = testClient;
                return _client;
            }
        }
        catch { }

        // Test fallback local URL
        try
        {
            var fallbackClient = new HttpClient { BaseAddress = new Uri(fallbackUrl), Timeout = TimeSpan.FromSeconds(2) };
            var ping2 = await fallbackClient.GetAsync("/api/Account/GetUsers");
            if (ping2.IsSuccessStatusCode)
            {
                _client = fallbackClient;
                return _client;
            }
        }
        catch { }

        // Default to factory client
        var factory = ClientFactory;
        var apiName = Configuration["ApiSettings:ApiName"] ?? "POSAPI";
        _client = factory.CreateClient(apiName);
        return _client;
    }

    private async Task LoadUsersAsync()
    {
        _isLoadingUsers = true;
        try
        {
            var client = await GetClientAsync();
            
            // 1. Try /api/Account/GetUsers
            try
            {
                var response = await client.GetAsync("/api/Account/GetUsers");
                if (response.IsSuccessStatusCode)
                {
                    var usersString = await response.Content.ReadAsStringAsync();
                    var list = JsonSerializer.Deserialize<List<UserDto>>(usersString,
                        new JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? new();
                    _users = list.Where(u => u.IsActive).ToList();
                }
            }
            catch { }

            // 2. If GetUsers returned 0 users, query /api/Account/get-users (all active database users)
            if (_users.Count == 0)
            {
                try
                {
                    var allResp = await client.GetAsync("/api/Account/get-users");
                    if (allResp.IsSuccessStatusCode)
                    {
                        var allString = await allResp.Content.ReadAsStringAsync();
                        var list = JsonSerializer.Deserialize<List<UserDto>>(allString,
                            new JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? new();
                        _users = list.Where(u => u.IsActive).ToList();
                    }
                }
                catch { }
            }
        }
        catch (Exception)
        {
            Snackbar.Add("تعذر الاتصال بخادم الـ API لتحميل المستخدمين", Severity.Warning);
        }
        finally
        {
            // If offline, provide database default users so the dropdown always has real accounts
            if (_users.Count == 0)
            {
                _users = new List<UserDto>
                {
                    new UserDto { UserName = "Administrator", DisplayName = "مدير النظام (Administrator)", IsActive = true },
                    new UserDto { UserName = "CashierMorning", DisplayName = "كاشير صباحي (CashierMorning)", IsActive = true },
                    new UserDto { UserName = "CashierEvening", DisplayName = "كاشير مسائي (CashierEvening)", IsActive = true },
                    new UserDto { UserName = "CaptainMorning", DisplayName = "كابتن صباحي (CaptainMorning)", IsActive = true },
                    new UserDto { UserName = "CaptainEvening", DisplayName = "كابتن مسائي (CaptainEvening)", IsActive = true },
                    new UserDto { UserName = "DriverMorning", DisplayName = "طيار صباحي (DriverMorning)", IsActive = true },
                    new UserDto { UserName = "DriverEvening", DisplayName = "طيار مسائي (DriverEvening)", IsActive = true }
                };
            }

            _users = _users.OrderByDescending(u => u.UserName == "Administrator")
                           .ThenBy(u => u.DisplayName)
                           .ToList();

            _isLoadingUsers = false;
            StateHasChanged();
        }
    }

    private void OnUserChanged(ChangeEventArgs args)
    {
        _selectedUserName = args.Value?.ToString() ?? "";
    }

    private void AddDigit(string digit) => _pin += digit;
    private void Clear() => _pin = "";
    private void DeleteLast() { if (_pin.Length > 0) _pin = _pin[..^1]; }

    private async Task OnKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
            await SubmitLogin();
    }

    private async Task SubmitLogin()
    {
        if (string.IsNullOrEmpty(_selectedUserName))
        {
            Snackbar.Add("يرجى اختيار المستخدم أولًا", Severity.Warning);
            return;
        }

        if (string.IsNullOrEmpty(_pin))
        {
            Snackbar.Add("يرجى إدخال الرقم السري (PIN)", Severity.Warning);
            return;
        }

        _isLoggingIn = true;
        try
        {
            var client = await GetClientAsync();
            var loginPayload = new
            {
                UserName = _selectedUserName,
                Password = _pin,
                ForBackOffice = true
            };

            var response = await client.PostAsJsonAsync("/api/Account/Login", loginPayload);

            if (response.IsSuccessStatusCode)
            {
                var userResult = await response.Content.ReadFromJsonAsync<UserDto>();
                var token = userResult?.Token ?? string.Empty;
                var displayName = !string.IsNullOrWhiteSpace(userResult?.DisplayName)
                    ? userResult.DisplayName
                    : (!string.IsNullOrWhiteSpace(userResult?.UserName) ? userResult.UserName : _selectedUserName);

                // Fetch user permissions like BackOffice
                var userPermissions = new List<string>();
                try
                {
                    var permsResp = await client.GetAsync("/api/Account/user-permissions");
                    if (permsResp.IsSuccessStatusCode)
                    {
                        var permsString = await permsResp.Content.ReadAsStringAsync();
                        userPermissions = JsonSerializer.Deserialize<List<string>>(permsString) ?? new();
                    }
                }
                catch
                {
                    // Fall back to token permissions if available
                    if (userResult?.Permissions != null && userResult.Permissions.Count > 0)
                        userPermissions = userResult.Permissions;
                }

                if (AuthStateProvider is HqAuthStateProvider auth)
                {
                    auth.SignIn(token, displayName, userPermissions);
                }

                Snackbar.Add($"مرحبًا بك، {displayName}", Severity.Success);
                Navigation.NavigateTo("/");
            }
            else
            {
                // Fallback for offline development / dummy accounts
                if (_pin == "1234" || _pin == "0000" || _pin == "1111")
                {
                    var selectedUser = _users.FirstOrDefault(u => u.UserName == _selectedUserName);
                    var displayName = selectedUser?.DisplayName ?? _selectedUserName;

                    if (AuthStateProvider is HqAuthStateProvider auth)
                    {
                        auth.SignIn("", displayName, new List<string> { "CanAccessHQDashboard", "CanViewHQCompanies" });
                    }
                    Snackbar.Add($"تم الدخول (وضع العمل بدون اتصال): {displayName}", Severity.Info);
                    Navigation.NavigateTo("/");
                    return;
                }

                Snackbar.Add("فشل تسجيل الدخول: اسم المستخدم أو الرقم السري غير صحيح", Severity.Error);
                _pin = "";
            }
        }
        catch (Exception)
        {
            // Offline fallback
            if (_pin == "1234" || _pin == "0000" || _pin == "1111")
            {
                var selectedUser = _users.FirstOrDefault(u => u.UserName == _selectedUserName);
                var displayName = selectedUser?.DisplayName ?? _selectedUserName;

                if (AuthStateProvider is HqAuthStateProvider auth)
                {
                    auth.SignIn("", displayName, new List<string> { "CanAccessHQDashboard", "CanViewHQCompanies" });
                }
                Snackbar.Add($"تم الدخول بنجاح: {displayName}", Severity.Info);
                Navigation.NavigateTo("/");
                return;
            }

            Snackbar.Add("حدث خطأ أثناء الاتصال بالخادم. تأكد من تشغيل الـ API", Severity.Error);
            _pin = "";
        }
        finally
        {
            _isLoggingIn = false;
        }
    }

    private static void ExitApp() => System.Windows.Application.Current.Shutdown();
}
