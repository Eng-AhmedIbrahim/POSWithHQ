@page "/login"
@layout AuthLayout
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject ISnackbar Snackbar
@using HQ.Desktop.Auth

<div class="login-page">
    <!-- Left Brand Section - Luxury Gold Gradient -->
    <div class="brand-section">
        <button class="close-app-btn" @onclick="ExitApp" title="إغلاق التطبيق">
            <i class="bi bi-x-lg"></i>
        </button>

        <div class="brand-content">
            <!-- HQ Gold Badge / Logo -->
            <div class="brand-logo-container">
                <div class="brand-logo-glow"></div>
                <div class="brand-logo">
                    <svg viewBox="0 0 100 100" class="hq-emblem-svg">
                        <defs>
                            <linearGradient id="goldGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                                <stop offset="0%" stop-color="#fff8db" />
                                <stop offset="35%" stop-color="#f5d061" />
                                <stop offset="70%" stop-color="#c99718" />
                                <stop offset="100%" stop-color="#8a6104" />
                            </linearGradient>
                            <linearGradient id="goldStroke" x1="0%" y1="0%" x2="100%" y2="100%">
                                <stop offset="0%" stop-color="#fdf4c9" />
                                <stop offset="50%" stop-color="#d4af37" />
                                <stop offset="100%" stop-color="#7a5500" />
                            </linearGradient>
                        </defs>
                        <!-- Stylized Headquarters Building Roof / Crown -->
                        <path d="M50 14 L84 38 L76 38 L76 82 L24 82 L24 38 L16 38 Z"
                              fill="none" stroke="url(#goldStroke)" stroke-width="4.5" stroke-linejoin="round" />
                        <!-- Golden Spire Peak -->
                        <polygon points="50,18 42,34 58,34" fill="url(#goldGrad)" />
                        <!-- Monogram HQ -->
                        <text x="50" y="66" text-anchor="middle"
                              fill="url(#goldGrad)"
                              font-family="'Tajawal', 'Segoe UI', sans-serif"
                              font-size="25"
                              font-weight="900"
                              letter-spacing="-1">HQ</text>
                    </svg>
                </div>
            </div>

            <h1 class="brand-title">New Tech HQ</h1>
            <p class="brand-subtitle">HEADQUARTERS MANAGEMENT SYSTEM</p>
        </div>
    </div>

    <!-- Right Login Section -->
    <div class="login-section">
        <div class="login-card">
            <div class="login-header">
                <h2>مرحبًا بك</h2>
            </div>

            <div class="login-form">
                <div class="form-group">
                    <select dir="rtl" class="form-control-custom select-user" @onchange="OnUserChanged">
                        <option value="" disabled selected="@(string.IsNullOrEmpty(_userName))">اختر المستخدم</option>
                        @foreach (var user in _users)
                        {
                            <option value="@user.Name">@user.Name</option>
                        }
                    </select>
                </div>

                <div class="form-group">
                    <input type="password" class="form-control-custom otp-display" placeholder="الرقم السري"
                           @bind="_pin" @bind:event="oninput" @onkeydown="OnKeyDown" />
                </div>

                <div class="keypad-container">
                    <div class="keypad-grid">
                        @for (var i = 1; i <= 9; i++)
                        {
                            var digit = i.ToString();
                            <div class="keypad-btn" @onclick="() => AddDigit(digit)">@digit</div>
                        }
                        <div class="keypad-btn action-btn bs" @onclick="DeleteLast">
                            <i class="bi bi-backspace"></i>
                        </div>
                        <div class="keypad-btn" @onclick='() => AddDigit("0")'>0</div>
                        <div class="keypad-btn action-btn del" @onclick="Clear">C</div>
                    </div>
                </div>

                <div class="action-buttons">
                    <button class="btn-custom btn-primary-custom" @onclick="SubmitLogin">دخول</button>
                    <button class="btn-custom btn-danger-custom" @onclick="ExitApp">خروج</button>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private readonly (string Name, string Pin)[] _users =
    [
        ("مدير المقر", "1234"),
        ("مدير العمليات", "0000"),
        ("مدير الحسابات", "1111"),
        ("المشرف العام", "2222")
    ];

    private string _userName = "";
    private string _pin = "";

    private void OnUserChanged(ChangeEventArgs args) => _userName = args.Value?.ToString() ?? "";
    private void AddDigit(string digit) => _pin += digit;
    private void Clear() => _pin = "";
    private void DeleteLast() { if (_pin.Length > 0) _pin = _pin[..^1]; }

    private void OnKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
            SubmitLogin();
    }

    private void SubmitLogin()
    {
        var user = _users.FirstOrDefault(u => u.Name == _userName);
        if (string.IsNullOrEmpty(_userName))
        {
            Snackbar.Add("اختر المستخدم أولًا", Severity.Warning);
            return;
        }
        if (user.Pin != _pin)
        {
            Snackbar.Add("الرقم السري غير صحيح", Severity.Error);
            return;
        }

        if (AuthStateProvider is HqAuthStateProvider auth)
            auth.SignIn(_userName);
        Navigation.NavigateTo("/");
    }

    private static void ExitApp() => System.Windows.Application.Current.Shutdown();
}
